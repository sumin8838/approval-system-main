{
  // VS Code 메뉴: 터미널 → 작업 실행 → "전자결재: 전체 실행"
  "version": "2.0.0",
  "tasks": [
    {
      "label": "전자결재: 전체 실행",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "전자결재: 백엔드만",
      "type": "shell",
      "command": "npm run dev:back",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "전자결재: 프론트만",
      "type": "shell",
      "command": "npm run dev:front",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
