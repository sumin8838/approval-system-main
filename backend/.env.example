# 이 파일을 복사해서 같은 폴더(backend)에 .env 라는 이름으로 만들고, 실제 값으로 바꾼다.
# 값은 Supabase 대시보드 > Connect > Session pooler 에서 확인.
# 따옴표 없이, = 앞뒤에 띄어쓰기 없이 적는다.

# 예: aws-0-ap-northeast-2.pooler.supabase.com  (화면에 나온 host 그대로)
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com

# 예: postgres.abcdefghijklmnop  (postgres. 뒤에 프로젝트 ref 가 붙은 형태)
DB_USERNAME=postgres.YOUR_PROJECT_REF

# 프로젝트 만들 때 정한 Database password
# (비밀번호에 \ 문자는 쓰지 말 것 - 이 파일에서 특수하게 해석됨)
DB_PASSWORD=YOUR_DB_PASSWORD

# 전자서명용 사내 인증기관(CA) 개인키를 암호화하는 비밀번호 (12자 이상, 영문·숫자)
# 팀원 모두 "같은 값"을 써야 한다. 바꾸면 이미 만든 CA 를 열 수 없으니 정한 뒤에는 바꾸지 말 것.
CA_KEY_PASSWORD=CHANGE_ME_TEAM_CA_PASSWORD
